{
  "$defs": {
    "DefectionPrior": {
      "additionalProperties": false,
      "properties": {
        "beta": {
          "default": 1.0,
          "title": "Beta",
          "type": "number"
        },
        "pseudo_votes": {
          "default": 20.0,
          "exclusiveMinimum": 0,
          "title": "Pseudo Votes",
          "type": "number"
        },
        "stages": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "title": "DefectionPrior",
      "type": "object"
    },
    "PriorBeta": {
      "additionalProperties": false,
      "description": "A probability with a Beta(a, b) distribution, given as ``{beta: [a, b]}``.",
      "properties": {
        "beta": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Beta",
          "type": "array"
        }
      },
      "required": [
        "beta"
      ],
      "title": "PriorBeta",
      "type": "object"
    },
    "PriorRange": {
      "additionalProperties": false,
      "description": "A probability known only to lie in [low, high]: uniform in the Monte Carlo outer loop.",
      "properties": {
        "low": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "PriorRange",
      "type": "object"
    },
    "ScorePrior": {
      "additionalProperties": false,
      "description": "Logit shift ``intercept + slope * score`` for a bloc's members without history.",
      "properties": {
        "slope": {
          "title": "Slope",
          "type": "number"
        },
        "intercept": {
          "default": 0.0,
          "title": "Intercept",
          "type": "number"
        }
      },
      "required": [
        "slope"
      ],
      "title": "ScorePrior",
      "type": "object"
    },
    "Shift": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "bloc": {
          "title": "Bloc",
          "type": "string"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "article": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Article"
        }
      },
      "required": [
        "label",
        "bloc",
        "delta"
      ],
      "title": "Shift",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "office": {
          "title": "Office",
          "type": "string"
        }
      },
      "required": [
        "name",
        "office"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "articles": {
      "default": [
        "I"
      ],
      "items": {
        "type": "string"
      },
      "title": "Articles",
      "type": "array"
    },
    "rules": {
      "title": "Rules",
      "type": "string"
    },
    "composition": {
      "title": "Composition",
      "type": "string"
    },
    "party_priors": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/PriorRange"
            },
            {
              "$ref": "#/$defs/PriorBeta"
            }
          ]
        },
        "type": "object"
      },
      "default": {},
      "title": "Party Priors",
      "type": "object"
    },
    "overrides": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/PriorRange"
            },
            {
              "$ref": "#/$defs/PriorBeta"
            }
          ]
        },
        "type": "object"
      },
      "default": {},
      "title": "Overrides",
      "type": "object"
    },
    "cutoffs": {
      "default": [
        0.1,
        0.9
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Cutoffs",
      "type": "array"
    },
    "rho": {
      "default": 0.6,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Rho",
      "type": "number"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "shifts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Shift"
      },
      "title": "Shifts",
      "type": "array"
    },
    "committee_reports": {
      "default": false,
      "title": "Committee Reports",
      "type": "boolean"
    },
    "alignment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignment"
    },
    "alignment_weight": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Alignment Weight",
      "type": "number"
    },
    "alignment_chamber_weight": {
      "additionalProperties": {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
      },
      "default": {
        "house": 1.0,
        "senate": 0.0
      },
      "propertyNames": {
        "enum": [
          "house",
          "senate"
        ]
      },
      "title": "Alignment Chamber Weight",
      "type": "object"
    },
    "national_swing": {
      "default": false,
      "title": "National Swing",
      "type": "boolean"
    },
    "gate_correlation": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Gate Correlation",
      "type": "number"
    },
    "senate_tie_break": {
      "default": "none",
      "enum": [
        "none",
        "pro",
        "con"
      ],
      "title": "Senate Tie Break",
      "type": "string"
    },
    "attendance": {
      "default": "fixed",
      "enum": [
        "fixed",
        "random"
      ],
      "title": "Attendance",
      "type": "string"
    },
    "absence_rate": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Absence Rate",
      "type": "number"
    },
    "defection_prior": {
      "anyOf": [
        {
          "$ref": "#/$defs/DefectionPrior"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "score_prior": {
      "additionalProperties": {
        "$ref": "#/$defs/ScorePrior"
      },
      "default": {},
      "title": "Score Prior",
      "type": "object"
    },
    "uncertainty_draws": {
      "default": 0,
      "minimum": 0,
      "title": "Uncertainty Draws",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "target",
    "rules",
    "composition"
  ],
  "title": "Scenario",
  "type": "object"
}
