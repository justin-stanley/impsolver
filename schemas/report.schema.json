    "GateDetail": {
      "description": "One gate of one article: the rule, the count by bloc, and every member.\n\nThe member columns (``p``, ``source``, ``cls``) line up with the chamber roster in\n``ChamberRoster``. ``source`` holds indexes into ``sources``; ``cls`` has one letter per\nmember: P (counted PRO), C (counted CON), U (uncertain), A (absent).",
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "chamber": {
          "title": "Chamber",
          "type": "string"
        },
        "article": {
          "title": "Article",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "optional": {
          "title": "Optional",
          "type": "boolean"
        },
        "seats": {
          "title": "Seats",
          "type": "integer"
        },
        "vacancies": {
          "title": "Vacancies",
          "type": "integer"
        },
        "present": {
          "title": "Present",
          "type": "integer"
        },
        "base": {
          "title": "Base",
          "type": "integer"
        },
        "required": {
          "title": "Required",
          "type": "integer"
        },
        "rule": {
          "$ref": "#/$defs/RuleOut"
        },
        "blocs": {
          "items": {
            "$ref": "#/$defs/BlocTally"
          },
          "title": "Blocs",
          "type": "array"
        },
        "p": {
          "items": {
            "type": "number"
          },
          "title": "P",
          "type": "array"
        },
        "source": {
          "items": {
            "type": "integer"
          },
          "title": "Source",
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "cls": {
          "title": "Cls",
          "type": "string"
        },
        "rank_pivot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank Pivot"
        }
      },
      "required": [
        "stage",
        "chamber",
        "article",
        "label",
        "optional",
        "seats",
        "vacancies",
        "present",
        "base",
